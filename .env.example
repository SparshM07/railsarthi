# Required: obtain this from your RailRadar account. Never commit the real value.
RAILRADAR_API_KEY=replace_with_raildar_api_key

# Recommended for every deployed environment. Clients send it as X-API-Key.
REQUIRE_API_KEY=true
APP_API_KEY=generate_a_long_random_secret_before_production

# Comma-separated browser origins allowed to call the API. Set this to your
# deployed frontend URL; never use * with authenticated requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-process safety limit. Use a gateway or Redis-based limiter when scaling.
REQUEST_RATE_LIMIT_PER_MINUTE=120
